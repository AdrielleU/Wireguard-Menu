#!/bin/bash
################################################################################
# wireguardmenu — CLI dispatcher for the WireGuard management scripts
#
# Usage:
#   wireguardmenu                  # launch the interactive menu (menu.sh)
#   wireguardmenu <command> [args] # run a single action, e.g:
#       wireguardmenu verify --all
#       wireguardmenu healthcheck -v
#       wireguardmenu list-peers
#   wireguardmenu help             # list commands
#   wireguardmenu install          # symlink this into /usr/local/bin
#   wireguardmenu uninstall        # remove that symlink
#
# All arguments after the command are passed straight through to the target
# script, so every flag the underlying script accepts still works.
################################################################################

set -euo pipefail

# Resolve the real location of this file, following any symlinks, so the
# command works whether it's run in place or via a symlink on $PATH. The
# scripts source utils.sh relative to their own path, so we must invoke them
# by their real absolute path (never the symlink).
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    dir="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$dir/$SOURCE"
done
REPO_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
# Absolute path to this real file — used for the install symlink so the link
# target never depends on the caller's working directory.
SELF="${REPO_DIR}/$(basename "$SOURCE")"

PROG="$(basename "$0")"
LINK_TARGET="/usr/local/bin/wireguardmenu"

# command  ->  "script.sh|one-line description"
# Ordered for the help output. A bare `wireguardmenu` opens menu.sh.
declare -A COMMANDS=(
    [setup]="menu.sh|Set up a new WireGuard server (in the menu)"
    [add-peer]="menu.sh|Add a client peer (in the menu)"
    [remove-peer]="menu.sh|Remove a peer (in the menu)"
    [list-peers]="menu.sh|List peers, wg show all (in the menu)"
    [toggle-peer]="menu.sh|Pause or resume a peer (in the menu)"
    [rotate-keys]="menu.sh|Rotate server or peer keys (in the menu)"
    [healthcheck]="healthcheck.sh|Run health checks (is the tunnel working now?)"
    [verify]="verify-config.sh|Verify the config matches the expected format"
    [log-connections]="log-connections.sh|Connection logging / audit"
    [menu]="menu.sh|Launch the interactive menu"
)

# Display order for help (assoc arrays are unordered in bash).
ORDER=(setup add-peer remove-peer list-peers toggle-peer \
       rotate-keys healthcheck verify log-connections menu)

# Convenience aliases
declare -A ALIASES=(
    [rotate]="rotate-keys"
    [ls]="list-peers"
    [add]="add-peer"
    [rm]="remove-peer"
    [remove]="remove-peer"
    [toggle]="toggle-peer"
    [health]="healthcheck"
    [check]="verify"
    [verify-config]="verify"
    [logs]="log-connections"
)

usage() {
    cat <<EOF
${PROG} — WireGuard management CLI

Usage:
  ${PROG}                 Launch the interactive menu
  ${PROG} <command> [...]  Run one action; extra args pass through to the script
  ${PROG} help             Show this help
  ${PROG} install          Symlink into ${LINK_TARGET%/*}
  ${PROG} uninstall        Remove that symlink
  ${PROG} test             Run every script's --dry-run (see: ${PROG} test --help)

Commands:
EOF
    local cmd script desc
    for cmd in "${ORDER[@]}"; do
        IFS='|' read -r script desc <<<"${COMMANDS[$cmd]}"
        printf "  %-16s %s\n" "$cmd" "$desc"
    done
    echo ""
    echo "Aliases: rotate=rotate-keys, add=add-peer, rm=remove-peer, ls=list-peers,"
    echo "         health=healthcheck, check=verify, logs=log-connections"
    echo ""
    echo "Scripts location: ${REPO_DIR}"
}

install_link() {
    local dest="$LINK_TARGET"
    if [[ $EUID -ne 0 ]]; then
        echo "install requires root — re-run with sudo" >&2
        exit 1
    fi
    ln -sf "$SELF" "$dest"
    chmod +x "$SELF"
    echo "Linked: $dest -> $SELF"
    echo "You can now run: $(basename "$dest") <command>"
}

uninstall_link() {
    local dest="$LINK_TARGET"
    if [[ $EUID -ne 0 ]]; then
        echo "uninstall requires root — re-run with sudo" >&2
        exit 1
    fi
    if [[ -L "$dest" ]]; then
        rm -f "$dest"
        echo "Removed: $dest"
    else
        echo "Nothing to remove at $dest"
    fi
}

# What `wireguardmenu test` runs: each script's own --dry-run. Every check they
# make, but nothing written — no units, no systemctl, no journal entries — so
# this is safe on a live server at any time.
# Each entry is a script in this repo followed by its arguments.
TEST_RUNS=(
    "install-healthcheck.sh --dry-run"
    "install-logging.sh --dry-run"
    "log-connections.sh --dry-run"
)

run_tests() {
    case "${1:-}" in
        "") ;;
        -h|--help)
            cat <<EOF
${PROG} test

Runs each script's own --dry-run:
$(printf '  %s\n' "${TEST_RUNS[@]}")
Every check a real run makes, but nothing written: no units, no systemctl and
no journal entries. Safe on a live server at any time.

Two more need no flag, because they only read: verify-config.sh, and
healthcheck.sh without --restart.

Requires root. Exits non-zero if any run fails.
EOF
            exit 0
            ;;
        *) echo "Unknown test option: $1 (test takes no options)" >&2; exit 2 ;;
    esac

    if [[ $EUID -ne 0 ]]; then
        echo "test requires root — re-run with sudo" >&2
        exit 1
    fi

    local failed=0 run path
    local -a args
    for run in "${TEST_RUNS[@]}"; do
        read -r -a args <<<"$run"
        path="${REPO_DIR}/${args[0]}"
        if [[ ! -x "$path" ]]; then
            echo "Missing or non-executable script: $path" >&2
            failed=$((failed + 1))
            continue
        fi
        echo
        echo "################  ${run}  ################"
        "$path" "${args[@]:1}" || failed=$((failed + 1))
    done

    echo
    echo "################  complete  ################"
    if (( failed == 0 )); then
        echo "All dry runs passed (${#TEST_RUNS[@]} run)."
        exit 0
    fi
    echo "${failed} of ${#TEST_RUNS[@]} dry run(s) failed." >&2
    exit 1
}

# Run a target script by its real absolute path so it can source utils.sh.
run_script() {
    local script="$1"; shift
    local path="${REPO_DIR}/${script}"
    [[ -f "$path" ]] || { echo "Script not found: $path" >&2; exit 1; }
    [[ -x "$path" ]] || chmod +x "$path" 2>/dev/null || true
    exec "$path" "$@"
}

main() {
    # No arguments → interactive menu.
    if [[ $# -eq 0 ]]; then
        run_script "menu.sh"
    fi

    local cmd="$1"; shift

    case "$cmd" in
        help|-h|--help)
            usage
            exit 0
            ;;
        install)
            install_link
            exit 0
            ;;
        uninstall)
            uninstall_link
            exit 0
            ;;
        test)
            run_tests "$@"
            ;;
    esac

    # Resolve aliases.
    if [[ -n "${ALIASES[$cmd]:-}" ]]; then
        cmd="${ALIASES[$cmd]}"
    fi

    if [[ -n "${COMMANDS[$cmd]:-}" ]]; then
        local script desc
        IFS='|' read -r script desc <<<"${COMMANDS[$cmd]}"
        run_script "$script" "$@"
    fi

    echo "Unknown command: $cmd" >&2
    echo "Run '${PROG} help' for the list of commands." >&2
    exit 2
}

main "$@"
